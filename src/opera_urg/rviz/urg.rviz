    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /URG 192.168.0.101
        - /URG 192.168.0.111
        - /Reflector_Bar1
        - /Reflector_Bar1/Status1
        - /Reflector_Bar1/Topic1
        - /Line points1
      Splitter Ratio: 0.5
    Tree Height: 957
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
